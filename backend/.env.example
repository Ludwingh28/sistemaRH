# ── Entorno ───────────────────────────────────────────────────────────────────
# desarrollo | produccion. En producción: se oculta /docs, se exige una SECRET_KEY y una clave de admin seguras
# y el backend sirve también el frontend compilado (todo por un solo puerto).
ENTORNO=desarrollo

# ── App (BD propia del sistema RH) ────────────────────────────────────────────
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_NAME=sistema_rh
APP_DB_USER=postgres
APP_DB_PASSWORD=cambia-esta-clave-de-bd

# Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-un-valor-largo-y-aleatorio
# Vida de cada token (minutos): se renueva solo mientras la persona trabaja; sin actividad la sesión vence.
TOKEN_MINUTES=60
# Tope absoluto de una sesión (horas), aunque se renueve.
SESION_MAX_HORAS=12

# ── Administrador inicial (lo crea seed.py la primera vez) ────────────────────
# En producción: mínimo 10 caracteres, y bórrala de este archivo después de crear al administrador.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-clave

# ── BD del BI (solo lectura): asistencia y ausentismo ─────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nombre_bd
DB_USER=tu_usuario
DB_PASSWORD=clave

# ── Contratos: unidad compartida de RH ───────────────────────────────────────
# Raíz de la unidad (la carpeta «Docs_RRHH»). Dentro debe existir  Vendedores\<NOMBRE>\Contratos\<archivos>
# DESARROLLO: usa una carpeta local que simule la unidad, p. ej. C:\Users\TU_USUARIO\Docs_RRHH_dev (fuera de OneDrive,
# porque tendrá datos de personas). PRODUCCIÓN: cambia solo esta línea (y CONTRATOS_RUTA_RED) por E:\Docs_RRHH.
# La cuenta que ejecuta el servicio necesita permiso de lectura y escritura. Vacío = sin contratos en el sistema.
CONTRATOS_DIR=E:\Docs_RRHH
# Cómo ve RH esa carpeta desde sus PCs (solo se muestra en pantalla, para que copien la ruta)
CONTRATOS_RUTA_RED=\\SERVIDOR\Docs_RRHH
CONTRATOS_MAX_MB=15

# ── Seguridad del inicio de sesión ────────────────────────────────────────────
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MIN=15

# ── Opcionales ────────────────────────────────────────────────────────────────
# Carpeta del frontend compilado (por defecto ../frontend/dist)
# FRONTEND_DIST=
# Solo si el frontend se sirve desde OTRO dominio que el backend (orígenes separados por coma)
# CORS_ORIGINS=https://rh.cruzimex.com
